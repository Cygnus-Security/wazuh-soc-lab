    <if_sid>110800</if_sid>
    <match type="pcre2">(?i)(union\s+select|\b(or|and)\s+\d+\s*=\s*\d+|\b(or|and)\s+'[^']*'\s*=\s*'[^']*'|information_schema|pg_sleep\s*\(|sleep\s*\(|benchmark\s*\(|waitfor\s+delay|;\s*drop\s|/\*|--\s)</match>
    <options>no_full_log</options>
    <description>bGlobal: Possible SQL Injection Pattern in PostgreSQL Statement</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>injection,sqli,</group>
  </rule>

  <!-- Mass Assignment: write touching a privileged column (tune column list to real crAPI schema). -->
  <rule id="110802" level="12">
    <if_sid>110800</if_sid>
    <match type="pcre2">(?i)(update|insert)[\s\S]{0,400}(role|is_?admin|credit|balance|wallet|membership|permission)</match>
    <options>no_full_log</options>
    <description>bGlobal: Possible Mass Assignment - Write to Privileged Column</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>mass_assignment,bopla,</group>
  </rule>

  <!-- Error-based: malformed SQL = likely injection probing (leverages log_min_error_statement=error). -->
  <rule id="110803" level="10">
    <if_sid>110800</if_sid>
    <match type="pcre2">(?i)ERROR:\s+(syntax error|unterminated quoted string|invalid input syntax|operator does not exist|column .+ does not exist)</match>
    <options>no_full_log</options>
    <description>bGlobal: PostgreSQL Error - Possible SQL Injection Probing (malformed query)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>injection,sqli,</group>
  </rule>

</group>

<group name="bglobal,crapi,db,mongo,">

  <!-- Base: MongoDB JSON diagnostic log (msg + ctx present only in mongod json, not nginx json). -->
  <rule id="110830" level="0">
    <decoded_as>json</decoded_as>
    <field name="msg" type="pcre2">.+</field>
    <field name="ctx" type="pcre2">.+</field>
    <description>bGlobal: MongoDB JSON log (base)</description>
  </rule>

  <!-- NoSQLi operators appearing in a logged command. -->
  <rule id="110831" level="12">
    <if_sid>110830</if_sid>
    <match type="pcre2">(?i)(\$where|\$ne|\$gt|\$lt|\$nin|\$regex)</match>
    <options>no_full_log</options>
    <description>bGlobal: Possible NoSQL Injection Operator in MongoDB Command</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>injection,nosqli,</group>
  </rule>
 
</group>
