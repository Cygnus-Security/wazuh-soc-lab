    <url type="pcre2">(?i)^/api/(v[0-9]+/)?(user|users|vehicle|vehicles|order|orders|account|accounts|profile)/[0-9]+</url>
    <options>no_full_log</options>
    <description>bGlobal: API Object ID Access Pattern Detected - 2xx/3xx</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>bglobal,crapi,api,broken_access_control,bola_object_access,</group>
  </rule>

