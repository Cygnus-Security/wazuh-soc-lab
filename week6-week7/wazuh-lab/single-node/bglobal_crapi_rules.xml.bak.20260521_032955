  <!-- Web brute force / authentication scanning                 -->
  <!-- ========================================================= -->

  <!-- Web authentication failure on crAPI Identity API: 4xx -->
  <rule id="110200" level="6">
    <if_sid>31101</if_sid>
    <id>^(400|401|403|404|429)$</id>
    <url type="pcre2">(?i)^/identity/api/auth/(login|verify)</url>
    <options>no_full_log</options>
    <description>bGlobal: crAPI Web Authentication Failure Detected</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>bglobal,crapi,api,authentication,authentication_failed,web_bruteforce,</group>
  </rule>

  <!-- Web brute force: repeated 4xx authentication failures from same source IP -->
  <rule id="110201" level="12" frequency="5" timeframe="120" ignore="300">
    <if_matched_sid>110200</if_matched_sid>
    <same_srcip />
    <options>no_full_log</options>
    <description>bGlobal: Possible Web Brute Force - Repeated Authentication Failures From Same Source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>bglobal,crapi,api,authentication,bruteforce,correlation,</group>
  </rule>

