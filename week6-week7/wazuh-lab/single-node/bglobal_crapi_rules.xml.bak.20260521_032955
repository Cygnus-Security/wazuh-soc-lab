  <!-- BOLA/IDOR: vehicle location access using UUID-like object identifier - 2xx/3xx -->
  <rule id="110120" level="8">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)^/identity/api/v[0-9]+/vehicle/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/location</url>
    <options>no_full_log</options>
    <description>bGlobal: Possible BOLA/IDOR - Vehicle Location Object Access</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>bglobal,crapi,api,broken_access_control,bola_uuid_access,</group>
  </rule>

  <!-- BOLA/IDOR: failed vehicle location object access - 403/404 -->
  <rule id="110121" level="10">
    <if_sid>31101</if_sid>
    <id>^(401|403|404)$</id>
    <url type="pcre2">(?i)/identity/api/v[0-9]+/vehicle/.*/location/?</url>
    <options>no_full_log</options>
    <description>bGlobal: Possible BOLA/IDOR - Failed Vehicle Location Object Access</description>
    <mitre>
      <id>T1190</id>
    </mitre>
