  <!-- ========================================================= -->
  <!-- JWT alg:none heuristic                                    -->
  <!-- Requires JWT/header/token to appear in logged URL/query.   -->
  <!-- For accurate JWT detection, use WAF/app/header logs.       -->
  <!-- ========================================================= -->

  <!-- JWT alg:none indicator in URL/query string or logged request data - 2xx/3xx -->
  <rule id="110500" level="12">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)(alg(%22|")?\s*(:|%3a)\s*(%22|")?none|eyJhbGciOiJub25l|eyJhbGciOiAibm9uZSI)</url>
    <options>no_full_log</options>
    <description>bGlobal: Possible JWT Authentication Bypass Attempt - alg none</description>
    <mitre>
      <id>T1550</id>
    </mitre>
