# Replace all change_me values before exposing this lab to another machine.
SERVER_NAME=localhost
KEY_FILENAME=iris_dev_key.pem
CERT_FILENAME=iris_dev_cert.pem
INTERFACE_HTTPS_PORT=443

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=change_me_admin
POSTGRES_DB=iris_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

DOCKERIZED=1
IRIS_SECRET_KEY=change_me_iris_secret_key
IRIS_SECURITY_PASSWORD_SALT=change_me_password_salt
IRIS_UPSTREAM_SERVER=app
IRIS_UPSTREAM_PORT=8000
CELERY_BROKER=amqp://rabbitmq
IRIS_AUTHENTICATION_TYPE=local
